#!/usr/bin/env python3
"""LLM-judge checker: scores output.txt against the task's rubric.

The judge Claude runs behind the ardoise wall (blank slate) so the estate's
own CLAUDE.md conventions cannot colour the grading. Exit 0 whenever a valid
score was obtained — pass/fail comes from the grader's pass_threshold; exit 1
only for harness failures (no output, judge unreachable, unparseable twice).
"""

import json
import os
import pathlib
import re
import subprocess
import sys


def find_ardoise():
    cand = os.environ.get("ARDOISE_SH",
                          os.path.expanduser("~/repos/spm1001/trousse/scripts/ardoise.sh"))
    if os.access(cand, os.X_OK):
        return cand
    cache = pathlib.Path(os.path.expanduser("~/.claude/plugins/cache"))
    hits = sorted(cache.glob("*/trousse/*/scripts/ardoise.sh"), reverse=True)
    for h in hits:
        if os.access(h, os.X_OK):
            return str(h)
    print("judge: ardoise.sh not found (set ARDOISE_SH)", file=sys.stderr)
    sys.exit(1)


def extract_json(text):
    """First parseable JSON object in text, tolerating markdown fences."""
    text = re.sub(r"```(?:json)?", "", text)
    dec = json.JSONDecoder()
    for m in re.finditer(r"\{", text):
        try:
            obj, _ = dec.raw_decode(text[m.start():])
            if isinstance(obj, dict) and "score" in obj:
                return obj
        except ValueError:
            continue
    return None


def main():
    run_dir = pathlib.Path(os.environ["SMEVALS_RUN_DIR"])
    rubric = os.environ.get("SMEVALS_TASK_RUBRIC")
    if not rubric:
        print("judge: task has no rubric: key", file=sys.stderr)
        sys.exit(1)
    model = os.environ.get("SMEVALS_CHECK_MODEL", "sonnet")

    output_path = run_dir / "output.txt"
    if not output_path.exists():
        print("judge: no output.txt in run dir", file=sys.stderr)
        sys.exit(1)
    response = output_path.read_text().strip()
    if not response:
        print(json.dumps({"score": 0.0, "notes": "empty model response",
                          "metrics": {"judge_score": 0.0}}))
        sys.exit(0)

    prompt = f"""You are grading the response of an AI assistant that was asked to help a user with their task-management system. Grade strictly against the rubric — the rubric states ground truth about the user's system, which you must take as fact. The rubric is a floor, not a fence: it is NOT exhaustive, so details in the response that go beyond it (other tasks, counts, names, dates) are not fabrication unless they CONTRADICT something the rubric states. Score what the rubric requires; ignore accurate-looking extra colour.

RUBRIC:
{rubric}

ASSISTANT'S RESPONSE TO GRADE:
---
{response}
---

Reply with ONLY a JSON object, no other text: {{"score": <float between 0.0 and 1.0>, "notes": "<two or three sentences justifying the score against the rubric>"}}"""

    ardoise = find_ardoise()
    verdict = None
    for _ in range(2):
        proc = subprocess.run(
            [ardoise, "-p", "--model", model, "--max-turns", "2", "--", prompt],
            capture_output=True, text=True, timeout=600)
        if proc.returncode != 0:
            continue
        verdict = extract_json(proc.stdout)
        if verdict:
            break
    if not verdict:
        print("judge: could not obtain a parseable verdict", file=sys.stderr)
        sys.exit(1)

    score = max(0.0, min(1.0, float(verdict["score"])))
    print(json.dumps({
        "score": round(score, 3),
        "metrics": {"judge_score": round(score, 3)},
        "notes": str(verdict.get("notes", ""))[:1000],
    }))
    sys.exit(0)


if __name__ == "__main__":
    main()
