# ── Parser (mirrors cli.py) ──────────────────────────────────────────────────

def build_parser():
    parser = argparse.ArgumentParser(
        description="Todoist CLI - MCP-free interface using official Python SDK")
    parser.add_argument("--version", "-V", action="version", version="accomplis 1.35.0")
    sub = parser.add_subparsers(dest="command")

    p = sub.add_parser("auth", help="Authenticate with Todoist")
    p.add_argument("--token")
    p.add_argument("--status", action="store_true")

    sub.add_parser("projects", help="List all projects")

    p = sub.add_parser("sections", help="List sections")
    p.add_argument("--project-id")
    p.add_argument("--project")

    p = sub.add_parser("tasks", help="List tasks")
    p.add_argument("--project-id")
    p.add_argument("--project")
    p.add_argument("--section-id")
    p.add_argument("--section")
    p.add_argument("--label")
    p.add_argument("--assignee")
    p.add_argument("--created-before")
    p.add_argument("--older-than")
    p.add_argument("--team", action="store_true")
    p.add_argument("--unassigned", action="store_true")
    p.add_argument("--include-section-name", action="store_true")

    p = sub.add_parser("task", help="Get a single task")
    p.add_argument("id")

    p = sub.add_parser("filter", help="Filter tasks using Todoist filter syntax")
    p.add_argument("query")

    p = sub.add_parser("done", help="Complete a task")
    p.add_argument("id")
    p.add_argument("--note")

    p = sub.add_parser("delete", help="Delete a task")
    p.add_argument("id")

    p = sub.add_parser("uncomplete", help="Uncomplete/reopen a task")
    p.add_argument("id")

    p = sub.add_parser("completed", help="List completed tasks")
    p.add_argument("--since")
    p.add_argument("--until")
    p.add_argument("--project")

